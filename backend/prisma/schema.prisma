generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tour {
  id        Int          @id @default(autoincrement())
  location  String
  country   String
  title     String
  review    Int
  days      Int
  price     Float
  image     String
  maxPeople Int
  minAge    Int
  type      String
  overview  String
  latitude  Float
  longitude Float
  updatedAt DateTime?   @default(now())
  createdAt DateTime?   @default(now())

  @@map ("tours")
}
