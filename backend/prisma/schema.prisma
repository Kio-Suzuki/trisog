generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tour {
  id        Int      @id @default(autoincrement())
  location  String
  country   String
  title     String
  review    Int
  days      Int
  price     Float
  image     String

  @@map("Tours")
}