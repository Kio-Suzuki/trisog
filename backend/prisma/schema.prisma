generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tour {
  id        Int       @id @default(autoincrement())
  location  String
  country   String
  continent String
  title     String
  startDate String
  endDate   String
  days      Int
  price     Float
  image     String
  maxPeople Int
  minAge    Int
  type      String
  overview  String
  latitude  Float
  longitude Float
  reviews   Review[]
  updatedAt DateTime? @default(now())
  createdAt DateTime? @default(now())

  @@map("tours")
}

model Destination {
  id         Int       @id @default(autoincrement())
  country    String
  about      String
  img        String
  latitude   Float
  longitude  Float
  currency   String
  language   String
  area       Int
  population Int
  timezone   String
  timetravel String
  travelers  Int
  capital    String
  updatedAt  DateTime? @default(now())
  createdAt  DateTime? @default(now())

  @@map("destinations")
}

model User {
  id        String    @id
  email     String
  firstname String?
  lastname  String?
  image     String?
  reviews   Review[]
  updatedAt DateTime? @default(now())
  createdAt DateTime? @default(now())

  @@map("users")
}

model Review {
  id        Int       @id @default(autoincrement())
  name      String?
  email     String?
  image     String?
  comment   String
  services  Int
  locations Int
  amenities Int
  prices    Int
  food      Int
  rooms     Int
  overall   Float
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tour      Tour      @relation(fields: [tourId], references: [id])
  tourId    Int
  updatedAt DateTime? @default(now())
  createdAt DateTime? @default(now())

  @@map("reviews")
}
